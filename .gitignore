# Allowlist strategy: ignore EVERYTHING by default.
# Only explicitly whitelisted config is tracked.
# New files (caches, transcripts, secrets) can never leak by accident.
*

# --- tracked config (allowlist) ---
!.gitignore
!README.md
!CLAUDE.md
!settings.json
!statusline-command.sh
!LICENSE
!NOTICE

# Generated by hooks/skill-index.js, but tracked deliberately: CLAUDE.md points
# Claude here to find skills that never reach the session listing, and the hook
# that rebuilds it swallows its own errors so a session never dies over a
# catalog. Committing it means a clone is correct before any hook has run.
!SKILL-INDEX.md

!rules/
!rules/**

# The mode corpus: the 25 rules whose priority varies by mode, the mode files
# that order them, and the pre-cut copy of CLAUDE.md that `ccfg probe run
# corpus-fidelity` checks them against. Whitelisted because the `*` rule above
# would otherwise ship the renderer with nothing to render -- a clone would get
# `ccfg mode` and an empty mode list.
!modes/
!modes/**

# Behavioural probes. Every claim in the mode corpus about what a rule actually
# does to the model came out of one of these, and a claim whose evidence did not
# survive the clone is an assertion.
!probes/
!probes/**

# Slash commands. Previously swallowed by the `*` rule above, so `/commit` lived
# only on the machine that wrote it and a fresh clone came up without it.
!commands/
!commands/**

# Long-form docs. README is the landing page; each concern has a page here.
!docs/
!docs/**

# Terminal themes referenced by settings.json.
!themes/
!themes/**

# Marketplace manifest: lets anyone install these skills with
# `/plugin marketplace add <owner>/claude-config`.
!.claude-plugin/
!.claude-plugin/**

# Generated by scripts/build-marketplace.js. Committed rather than built on
# demand because a marketplace is served from the repository exactly as cloned,
# and because a plugin must carry its own copy of a skill: Claude Code always
# scans a plugin's own skills/ directory, so a plugin rooted here would publish
# all of skills/ regardless of what its manifest claimed.
!marketplace/
!marketplace/**

!.github/
!.github/**

!skills/
!skills/**

!hooks/
!hooks/**

!tools/
!tools/**

!scripts/
!scripts/**

!zed/
!zed/**

# --- hard excludes (defense in depth, even if whitelisted above by mistake) ---
.DS_Store
*.bak
*.orig
*.log
.credentials.json
settings.local.json
secrets.env
shell-init.sh
history.jsonl
/projects/
/sessions/
/session-env/
/shell-snapshots/
/file-history/
/paste-cache/
# The install cache is 1.2GB of vendored plugin trees -- node_modules, not config.
# installed_plugins.json is its lockfile (versions + commit SHAs) and settings.json
# only records which plugins are enabled, so without it a clone floats to whatever
# the marketplaces serve that day.
!plugins/
plugins/cache/
plugins/marketplaces/
plugins/data/
plugins/plugin-catalog-cache.json
!plugins/installed_plugins.json
!plugins/known_marketplaces.json
# Anchored to the repository root with a leading slash. Written bare, each of
# these matches a directory of that name at any depth, and `debug/` duly
# swallowed modes/commands/debug/ -- so TRACE shipped declaring a command whose
# file was never committed, and applying it on a fresh clone would throw.
/cache/
/debug/
/telemetry/
/tasks/
/backups/
/downloads/
/ide/
stats-cache.json
mcp-needs-auth-cache.json
credentials
credentials.dpapi
*.dpapi

__pycache__/
*.pyc

# scratch: prepared commit messages, not part of the config
.commit-msgs/

# Personal writing samples: read from disk by daniel-voice, never published.
skills/daniel-voice/references/samples/
